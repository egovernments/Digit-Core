  {
   "source": "JsonDocumentInspectorTest#skipPathSuppressesOnlyItsMatchedSubtree",
   "kind": "json",
   "input": "{\"items\":[{\"note\":\"<b>\"},{\"note\":\"<i>\"}],\"other\":\"<u>\"}",
   "config": {
    "skipPaths": [
     "/items/0"
    ]
   },
   "expected": {
    "violations": [
     {
      "location": "/items/1/note"
     },
     {
      "location": "/other"
     }
    ]
   }
  },
  {
   "source": "JsonDocumentInspectorTest#duplicateChecksRemainActiveInsideSkippedSubtree",
   "kind": "json",
   "input": "{\"safe\":{\"x\":1,\"x\":2}}",
   "config": {
    "skipPaths": [
     "/safe"
    ],
    "rejectDuplicateKeys": true
   },
   "expected": {
    "code": "REQUEST_JSON_DUPLICATE_KEY",
    "location": "/safe/x"
   },
   "note": "duplicate-key check is NOT suppressed by a matching skip path; only content detection is skipped"
  },
  {
   "source": "JsonDocumentInspectorTest#contentConsumerMayEnforceImmediately",
   "kind": "json",
   "input": "{\"value\":\"<script\"}",
   "config": {
    "consumerThrowsOnFirstViolation": true
   },
   "expected": {
    "code": "REQUEST_CONTENT_NOT_ALLOWED",
    "ruleId": "R1"
   },
   "note": "models ENFORCE mode: the content-violation consumer itself throws, inspect() does not catch it, it propagates uncaught"
  },
