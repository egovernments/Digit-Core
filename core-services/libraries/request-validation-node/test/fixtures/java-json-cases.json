{
 "notice": "The kind=json cases of the Java library test suite (JsonDocumentInspectorTest), as recorded from the Java sources; expectations are the Java tests own assertions.",
 "cases": [
  {
   "source": "JsonDocumentInspectorTest#inspectsUnknownPropertiesNestedObjectsAndArrays",
   "kind": "json",
   "input": "{\"known\":\"ok\",\"unknown\":[{\"a\":{\"b\":{\"c\":{\"d\":\"<script\"}}}}]}",
   "config": {},
   "expected": {
    "violations": [
     {
      "ruleId": "R1",
      "location": "/unknown/0/a/b/c/d"
     }
    ]
   }
  },
  {
   "source": "JsonDocumentInspectorTest#inspectsPropertyNamesAndRedactsUnsafeNameFromLocation",
   "kind": "json",
   "input": "{\"onload=\":true}",
   "config": {},
   "expected": {
    "violations": [
     {
      "ruleId": "R3",
      "location": "/*"
     }
    ]
   },
   "note": "the KEY itself is content-inspected, not only values; booleans are never content-inspected but the key always is"
  },
  {
   "source": "JsonDocumentInspectorTest#locationsStayCorrectAcrossSiblingContainersAndArrays",
   "kind": "json",
   "input": "{\"a\":[{\"x\":1},{\"y\":\"<b>\"},[\"ok\",\"<i>\"]],\"b\":{\"c\":\"<u>\"},\"d\":[{\"<k>\":1}],\"e\":\"<s>\"}",
   "config": {},
   "expected": {
    "locations": [
     "/a/1/y",
     "/a/2/1",
     "/b/c",
     "/d/0/*",
     "/e"
    ]
   }
  },
  {
   "source": "JsonDocumentInspectorTest#locationsStayCorrectAcrossSiblingContainersAndArrays",
   "kind": "json",
   "input": "[\"ok\",[\"<b>\"]]",
   "config": {},
   "expected": {
    "locations": [
     "/1/0"
    ]
   }
  },
  {
   "source": "JsonDocumentInspectorTest#locationsStayCorrectAcrossSiblingContainersAndArrays",
   "kind": "json",
   "input": "\"<b>\"",
   "config": {},
   "expected": {
    "locations": [
     "/"
    ]
   },
   "note": "a bare scalar root value"
  },
