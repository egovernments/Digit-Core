  {
   "source": "JsonDocumentInspectorTest#failureLocationsNameTheOffendingProperty",
   "kind": "json",
   "input": "{\"a\":[{\"x\":1,\"x\":2}]}",
   "config": {
    "rejectDuplicateKeys": true
   },
   "expected": {
