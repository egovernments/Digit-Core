"source": "RequestValidationIntegrationTest#reportStopsScalarInspectionAtALimitButStillInspectsTheBody",
"kind": "http",
"config": {
"mode": "REPORT"
},
"annotation": {
"maxScalarLength": 20
},
"input": {
"method": "POST",
"path": "/scalars",
