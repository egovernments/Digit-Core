"source": "ValidationPolicyResolverTest#parameterOverridesModeAndBodySwitchWhilePathsCombine",
"kind": "annotation",
"input": {
"class": "@ValidateRequest(skipPaths='/class', reason='class markup')",
"method": "@ValidateRequest(structured=ENABLED, skipPaths='/method', reason='method markup')",
"parameter": "@ValidateRequest(structured=DISABLED, mode=ENFORCE, skipPaths='/parameter', reason='body disabled')"
},
"config": {
"structuredDefault": false
},
"expected": {
"parameterPolicy": {
"enabled": true,
"structured": false,
"mode": "ENFORCE",
"skipPaths": [
"/class",
"/method",
"/parameter"
],
"matcherMatches": [
"method",
"child"
]
},
"handlerPolicy": {
"structured": true
}
},
"note": "skip paths UNION across class+method+parameter; structured/mode take the most-specific non-DEFAULT value; handler-level (no parameter) resolution is structured=true from the method annotation"
},
