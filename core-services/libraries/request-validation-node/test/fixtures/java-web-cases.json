"source": "RequestValidationIntegrationTest#enforceRejectionIsLoggedEvenAfterReportFindingsFillTheCap",
"kind": "http",
"config": {
"mode": "ENFORCE"
},
"input": {
"method": "POST",
"path": "/mixed",
"contentType": "application/json",
"body": "\"<script>\"",
"query": {
"p0": "<a>",
"p1": "<a>",
"p2": "<a>",
"p3": "<a>",
"p4": "<a>",
"p5": "<a>",
"p6": "<a>",
"p7": "<a>",
"p8": "<a>",
"p9": "<a>"
}
},
"annotation": {
"methodMode": "REPORT",
"bodyParamMode": "ENFORCE"
},
"expected": {
"status": 400,
"loggedObservationCount": 10,
"loggedModesFirst9": "REPORT",
"loggedMode10th": "ENFORCE",
"loggedKind10th": "body"
},
"note": "10 query params each trigger a REPORT-mode scalar finding ('<a>' is markup-start); the 9-slot cap fills, the 10th log line is the ENFORCE-mode body rejection, exempted from the cap"
},
