"source": "EnvironmentVariableFallbackTest#declaresAVariableNoOtherSourceMentionsDirectlyAfterTheEnvironment",
"kind": "config",
"input": {
"env": {
"EGOV_REQUEST_VALIDATION_LIMITS_MAX_DEPTH": "${DEPTH}",
"EGOV_REQUEST_VALIDATION_MODE": "ENFORCE",
"DEPTH": "9"
},
"applicationProperties": {
"egov.request-validation.enabled": "true"
}
},
"expected": {
"declaredKeys": [
"egov.request-validation.mode",
"egov.request-validation.limits.max-depth"
],
"rawValueNotResolved": "${DEPTH}"
}
},
{
"source": "EnvironmentVariableFallbackTest#leavesASettingThatAnotherSourceSpellsInAnyFormToSpring",
"kind": "config",
"input": {
"otherSourceSpellings": [
"egov.request-validation.mode",
"egov.requestValidation.mode",
"egov.request_validation.mode",
"EGOV_REQUEST_VALIDATION_MODE",
"egov.request-validation.rules.denied-schemes[0]"
]
},
"expected": {
"declaredSourceCreated": false
},
"note": "any of these spellings from a non-env-var source is enough to suppress the fallback declaration for that key"
},
{
"source": "EnvironmentVariableFallbackTest#declaresAnEmptyListButNoOtherBlankSetting",
"kind": "config",
"input": {
"env": {
"EGOV_REQUEST_VALIDATION_ACTIVATION": "",
"EGOV_REQUEST_VALIDATION_LIMITS_MAX_DEPTH": "  ",
"EGOV_REQUEST_VALIDATION_RULES_URL_SCHEME": "${RV_EMPTY:}",
"EGOV_REQUEST_VALIDATION_LOG_REPORT_SAMPLE_RATE": "${RV_BLANK}",
"RV_BLANK": " ",
"EGOV_REQUEST_VALIDATION_RULES_DENIED_SCHEMES": "${RV_LIST:}",
"EGOV_REQUEST_VALIDATION_RULES_DENIED_DATA_MEDIA_TYPES": " ",
"EGOV_REQUEST_VALIDATION_MODE": "${RV_MODE}",
"RV_MODE": "ENFORCE",
"EGOV_REQUEST_VALIDATION_RULES_DECODE_ROUNDS": "${RV_MISSING}"
}
},
"expected": {
"declaredKeys": [
"egov.request-validation.mode",
"egov.request-validation.rules.denied-schemes",
"egov.request-validation.rules.decode-rounds"
]
},
"note": "blank scalar settings (activation, max-depth, url-scheme, log sample-rate, denied-data-media-types) are NOT declared at all (default stands); the empty-list setting (denied-schemes resolving to '') IS declared as a real empty list; an unresolvable placeholder (decode-rounds) is still declared as-is"
},
