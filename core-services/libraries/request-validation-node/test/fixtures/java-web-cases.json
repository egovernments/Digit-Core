{
"source": "EnvironmentVariablesTest#aSpringApplication",
"kind": "http",
"input": {
"env": {
"EGOV_REQUEST_VALIDATION_ENABLED": "true",
"EGOV_REQUEST_VALIDATION_STRUCTURED_DEFAULT": "${RV_STRUCTURED}",
"RV_STRUCTURED": "true",
"EGOV_REQUEST_VALIDATION_MODE": "ENFORCE",
"EGOV_REQUEST_VALIDATION_LIMITS_MAX_DEPTH": "3",
"EGOV_REQUEST_VALIDATION_RULES_DENIED_SCHEMES": "livescript"
},
"method": "POST",
"path": "/bytes",
"contentType": "application/json",
"cases": [
{
"body": "{\"u\":\"livescript:x\"}",
"expectedStatus": 400
},
{
"body": "{\"u\":\"javascript:x\"}",
"expectedStatus": 200,
"note": "javascript no longer in the (replaced) denied-schemes list"
},
{
"body": "{\"a\":{\"b\":{\"c\":{}}}}",
"expectedStatus": 400,
"note": "depth 4 exceeds maxDepth=3"
},
{
"body": "{\"a\":{\"b\":{}}}",
"expectedStatus": 200,
"note": "depth 3, exactly at the limit"
}
]
},
"expected": null
},
