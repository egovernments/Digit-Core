{
  "info": {
    "name": "notify-service",
    "description": "API collection for notify-service. Set the `baseUrl` and `tenantId` variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",  "value": "http://localhost:8080", "type": "string" },
    { "key": "tenantId", "value": "tenant-1",              "type": "string" },
    { "key": "configId", "value": "",                      "type": "string" },
    { "key": "mappingId","value": "",                      "type": "string" },
    { "key": "providerId","value": "",                     "type": "string" }
  ],
  "item": [
    {
      "name": "Notify",
      "item": [
        {
          "name": "Send notification",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notify",
            "header": [
              { "key": "X-Tenant-ID",   "value": "{{tenantId}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"OTP_SMS\",\n  \"recipient\": {\n    \"phone\": \"+911234567890\",\n    \"email\": null,\n    \"deviceTokens\": [],\n    \"countryCode\": \"IN\",\n    \"metadata\": {}\n  },\n  \"payload\": {\n    \"data\": {\n      \"otp\": \"123456\",\n      \"userName\": \"Aniket\"\n    }\n  },\n  \"locale\": \"en\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Dispatches a notification. Returns 202 with notificationId. Requires at least one NotificationConfig and ProviderMapping to be configured for the tenant."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "pm.test('notificationId present', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.notificationId).to.match(/^ntf_/);",
                  "});",
                  "pm.test('X-Response-Time header present', () => {",
                  "  pm.expect(pm.response.headers.get('X-Response-Time')).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notification Configs",
      "item": [
        {
          "name": "Create config (SMS only)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notification-configs",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"OTP_SMS\",\n  \"channels\": {\n    \"sms\": {\n      \"enabled\": true,\n      \"priority\": \"HIGH\",\n      \"body\": {\n        \"en\": \"Your OTP is {{otp}}. Valid for 10 minutes.\",\n        \"hi\": \"आपका OTP है {{otp}}। 10 मिनट के लिए वैध।\"\n      },\n      \"payloadBindings\": {\n        \"otp\": \"$.data.otp\"\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Creates a notification config for a templateCode. One active config per tenantId+templateCode."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('configId', body.id);",
                  "pm.test('id is a UUID', () => pm.expect(body.id).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create config (SMS + Email + Push)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notification-configs",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"WELCOME\",\n  \"channels\": {\n    \"sms\": {\n      \"enabled\": true,\n      \"priority\": \"MEDIUM\",\n      \"body\": {\n        \"en\": \"Welcome {{userName}}! Your account is ready.\"\n      },\n      \"payloadBindings\": {\n        \"userName\": \"$.data.userName\"\n      }\n    },\n    \"email\": {\n      \"enabled\": true,\n      \"priority\": \"MEDIUM\",\n      \"subject\": {\n        \"en\": \"Welcome to the platform, {{userName}}\"\n      },\n      \"body\": {\n        \"en\": \"<p>Hi {{userName}},</p><p>Your account has been created successfully.</p>\"\n      },\n      \"payloadBindings\": {\n        \"userName\": \"$.data.userName\"\n      }\n    },\n    \"push\": {\n      \"enabled\": true,\n      \"priority\": \"LOW\",\n      \"title\": {\n        \"en\": \"Welcome!\"\n      },\n      \"body\": {\n        \"en\": \"Hi {{userName}}, your account is ready.\"\n      },\n      \"payloadBindings\": {\n        \"userName\": \"$.data.userName\"\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Creates a multi-channel notification config."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('configId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List configs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notification-configs?isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["notification-configs"],
              "query": [
                { "key": "templateCode", "value": "", "disabled": true },
                { "key": "isActive",     "value": "true" }
              ]
            },
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "description": "Lists configs for the tenant. Filter by templateCode and/or isActive."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get config by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notification-configs/{{configId}}",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "description": "Fetch a single config by UUID. Uses {{configId}} set by the Create request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('id matches', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('configId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update config",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/notification-configs/{{configId}}",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"OTP_SMS\",\n  \"channels\": {\n    \"sms\": {\n      \"enabled\": true,\n      \"priority\": \"CRITICAL\",\n      \"body\": {\n        \"en\": \"Your OTP is {{otp}}. Do not share it. Valid for 5 minutes.\"\n      },\n      \"payloadBindings\": {\n        \"otp\": \"$.data.otp\"\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Full replace of a config. Uses {{configId}} set by the Create request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete config",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/notification-configs/{{configId}}",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "description": "Soft-deletes (sets isActive=false) a config. Returns 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Provider Mappings",
      "item": [
        {
          "name": "Create mapping (SMS global)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/provider-mappings",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"SMS\",\n  \"providers\": [\"template\", \"fallback-provider\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Maps a channel to an ordered list of providers. No country = global default. First provider is primary; rest are fallbacks."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('mappingId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create mapping (SMS country-specific)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/provider-mappings",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"SMS\",\n  \"country\": \"IN\",\n  \"providers\": [\"template\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Country-specific mapping takes precedence over the global default for recipients with countryCode=IN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('mappingId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List mappings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/provider-mappings",
              "host": ["{{baseUrl}}"],
              "path": ["provider-mappings"],
              "query": [
                { "key": "channel", "value": "SMS", "disabled": true }
              ]
            },
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "description": "Lists all provider mappings for the tenant. Optionally filter by channel."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update mapping",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/provider-mappings/{{mappingId}}",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"SMS\",\n  \"providers\": [\"template\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Replace the provider list for a mapping."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete mapping",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/provider-mappings/{{mappingId}}",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "description": "Deletes a provider mapping. Returns 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Providers",
      "item": [
        {
          "name": "List providers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/providers",
              "host": ["{{baseUrl}}"],
              "path": ["providers"],
              "query": [
                { "key": "channel",  "value": "SMS",  "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            },
            "description": "Lists all providers loaded from the /providers directory. No tenant header required. Filter by channel or isActive."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const body = pm.response.json();",
                  "if (body.length > 0) pm.collectionVariables.set('providerId', body[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Toggle provider active/inactive",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/providers/{{providerId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Enable or disable a provider without restarting the service. Uses {{providerId}} captured by List providers."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('isActive is false', () => pm.expect(pm.response.json().isActive).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health & Docs",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "description": "Spring Boot actuator health endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/docs",
            "description": "Opens the Swagger UI HTML page."
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api-docs",
            "description": "Returns the OpenAPI 3 JSON spec."
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Missing X-Tenant-ID → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notify",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"OTP_SMS\",\n  \"recipient\": { \"phone\": \"+911234567890\", \"deviceTokens\": [] },\n  \"payload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Omits X-Tenant-ID header — expects 400 BAD_REQUEST."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('code is BAD_REQUEST', () => pm.expect(pm.response.json().code).to.eql('BAD_REQUEST'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown templateCode → 404",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notify",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"DOES_NOT_EXIST\",\n  \"recipient\": { \"phone\": \"+911234567890\", \"deviceTokens\": [] },\n  \"payload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Uses a templateCode with no config — expects 404 NOT_FOUND."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('code is NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate config → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notification-configs",
            "header": [
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"OTP_SMS\",\n  \"channels\": {\n    \"sms\": { \"enabled\": true, \"priority\": \"HIGH\", \"body\": { \"en\": \"OTP: {{otp}}\" }, \"payloadBindings\": { \"otp\": \"$.data.otp\" } }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Creates OTP_SMS again when one already exists — expects 409 CONFLICT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('code is CONFLICT', () => pm.expect(pm.response.json().code).to.eql('CONFLICT'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
