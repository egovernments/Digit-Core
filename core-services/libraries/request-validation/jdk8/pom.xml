<?xml version="1.0" encoding="UTF-8"?>
<!--
  Java 8 / Spring Boot 2.x (javax.servlet) build of the same sources as ../pom.xml.
  The sources are copied with jakarta.servlet rewritten to javax.servlet; nothing else changes.
  jackson-core is shaded and relocated because the parser limits need StreamReadConstraints (2.15+),
  while Java 8 services manage an older Jackson. The host's own Jackson is left untouched.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.2.13.RELEASE</version>
    <relativePath/>
  </parent>
  <groupId>org.egov.services</groupId>
  <artifactId>request-validation-jdk8</artifactId>
  <version>1.0.1-SNAPSHOT</version>
  <name>request-validation-jdk8</name>
  <description>Opt-in, non-mutating Spring MVC request content validation (Java 8 / Spring Boot 2.x)</description>
  <properties>
    <java.version>1.8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <shared.sources>${project.basedir}/..</shared.sources>
    <generated.main>${project.build.directory}/generated-sources/jdk8</generated.main>
    <generated.test>${project.build.directory}/generated-test-sources/jdk8</generated.test>
    <shaded.jackson.version>2.18.6</shaded.jackson.version>
    <!-- Test only: the shared tests use AssertJ navigation added after Boot 2.2's 3.13. -->
    <assertj.version>3.24.2</assertj.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <!-- Shaded into this jar and removed from its published pom. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${shaded.jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.17.2</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Adopters supply tracer. Do not pull its Kafka/telemetry stack into this jar. -->
    <dependency>
      <groupId>org.egov.services</groupId>
      <artifactId>tracer</artifactId>
      <version>2.1.2-SNAPSHOT</version>
      <optional>true</optional>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${generated.main}</sourceDirectory>
    <testSourceDirectory>${generated.test}</testSourceDirectory>
    <resources>
      <resource><directory>${shared.sources}/src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/src/main/resources</directory></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>javax-main-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <delete dir="${generated.main}"/>
                <copy todir="${generated.main}" encoding="UTF-8" outputencoding="UTF-8">
                  <fileset dir="${shared.sources}/src/main/java"/>
                  <filterchain><replacestring from="jakarta.servlet." to="javax.servlet."/></filterchain>
                </copy>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>javax-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <delete dir="${generated.test}"/>
                <copy todir="${generated.test}" encoding="UTF-8" outputencoding="UTF-8">
                  <fileset dir="${shared.sources}/src/test/java"/>
                  <filterchain><replacestring from="jakarta.servlet." to="javax.servlet."/></filterchain>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <!-- Override Boot's application-oriented shade defaults (Main-Class, Spring transformers). -->
            <configuration combine.self="override">
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <includes><include>com.fasterxml.jackson.core:jackson-core</include></includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson.core</pattern>
                  <shadedPattern>org.egov.requestvalidation.shaded.jackson.core</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>com.fasterxml.jackson.core:jackson-core</artifact>
                  <!-- Keep the Java 8 base classes and the license files only. -->
                  <excludes>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>META-INF/services/**</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Built with JDK 9+, check the Java 8 API as well as the bytecode level. -->
    <profile>
      <id>release-8</id>
      <activation><jdk>[9,)</jdk></activation>
      <properties><maven.compiler.release>8</maven.compiler.release></properties>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>repo.digit.org</id>
      <url>https://nexus-repo.digit.org/nexus/content/repositories/snapshots/</url>
    </repository>
  </repositories>
  <distributionManagement>
    <snapshotRepository>
      <id>repo.digit.org</id>
      <url>https://nexus-repo.digit.org/nexus/content/repositories/snapshots/</url>
    </snapshotRepository>
  </distributionManagement>
</project>
